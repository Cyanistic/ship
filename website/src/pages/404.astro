---
import { withBase } from "../base";
import { modeScript, modeButton } from "../mode";
// "lost at sea": the 404, drawn from the landing's own pieces. Open water with no ship in it, the drift of
// flotsam on the waves, then the seabed and the footer. Absolute paths throughout, since a host serves this
// page at whatever address was missing.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>lost at sea · ship</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href={withBase("/marks/avatar.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;700&display=swap"
    />
    <link rel="stylesheet" href={withBase("/css/site.css")} />
    <link rel="stylesheet" href={withBase("/css/landing.css")} />
    <link rel="stylesheet" href={withBase("/css/lost.css")} />
    <link rel="stylesheet" href={withBase("/css/mode.css")} />
    <script is:inline set:html={modeScript}></script>
  </head>
  <body>
    <a class="skip" href="#lost">
      skip to the content
    </a>
    <header class="bar">
      <div class="bar-in">
        <a class="home" href={withBase("/")}>
          <img class="px" src={withBase("/marks/app.svg")} width="32" height="32" alt="" />
          <span class="wordmark pixel p22">ship</span>
          <span class="sr-only">ship, back to the landing page</span>
        </a>
        <nav aria-label="main">
          <ul>
            <li>
              <a href={withBase("/docs/")}>docs</a>
            </li>
            <li>
              <a href={withBase("/#install")}>install</a>
            </li>
            <li>
              <a href={withBase("/#keys")}>keys</a>
            </li>
            <li>
              <a href={withBase("/#config")}>config</a>
            </li>
            <li>
              <a href="https://github.com/shipmux/ship">github</a>
            </li>
          </ul>
        </nav>
        <Fragment set:html={modeButton} />
      </div>
    </header>

    <main>
      <section class="lost-sky" aria-hidden="true">
        <img class="cloud a px art" style="--w:51;--h:22" src={withBase("/art/cloud.svg")} alt="" />
        <img class="cloud c px art" style="--w:23;--h:15" src={withBase("/art/cloud-c.svg")} alt="" />
        <span class="gull g1"></span>
        <span class="gull g3"></span>
      </section>

      <section class="waterline lost" id="lost" aria-labelledby="lost-title">
        <div class="waves back tile" style="--tw:16;--th:4" aria-hidden="true"></div>
        <div class="waves tile" style="--tw:16;--th:5" aria-hidden="true"></div>
        <div class="shade" aria-hidden="true">
          <i class="d1"></i>
          <i class="s1"></i>
          <i class="d2"></i>
        </div>
        <div class="flotsam" aria-hidden="true">
          <img class="px art f1" style="--w:7;--h:10" src={withBase("/art/bottle.svg")} alt="" />
          <img class="px art f2" style="--w:18;--h:12" src={withBase("/art/float-sign.svg")} alt="" />
          <img class="px art f3" style="--w:16;--h:10" src={withBase("/art/buoy.svg")} alt="" />
          <img class="px art f4" style="--w:18;--h:4" src={withBase("/art/float-plank.svg")} alt="" />
        </div>
        <div class="deepwater" aria-hidden="true">
          <span class="fish s1 art" style="--w:12;--h:6"></span>
          <span class="fish s2 art" style="--w:12;--h:6"></span>
          <img class="bubble px art b1" style="--w:3;--h:3" src={withBase("/art/bubble.svg")} alt="" />
          <img class="bubble px art b2" style="--w:3;--h:3" src={withBase("/art/bubble.svg")} alt="" />
        </div>
        <div class="water-in">
          <div class="water-copy">
            <h1 id="lost-title" class="pixel p66">
              <span class="nb">lost at sea</span> <span class="plain">page not found</span>
            </h1>
            <p>
              nothing floats at this address. the page may have gone down with an older version of the docs, or it was
              never on the chart.
            </p>
            <div class="links">
              <a href={withBase("/")}>back to the ship</a>
              <a href={withBase("/docs/")}>read the docs</a>
              <a href={withBase("/#install")}>install ship</a>
            </div>
          </div>
          <figure class="lost-fig">
            <div class="term cmd">
              <pre><span class="t-prompt">$ </span>ship pane read --pane "$PAGE" 2&gt;err.log
<span class="t-prompt">$ </span>tail -n 1 err.log | jq -r .type.kind
not_found</pre>
            </div>
            <figcaption>ship would say the same about a pane that isn't there.</figcaption>
          </figure>
        </div>
        <div class="seafloor-dither" aria-hidden="true">
          <i class="d1"></i>
          <i class="s1"></i>
        </div>
      </section>

      <section class="seabed" aria-label="the seabed">
        <div class="water lost-water">
          <div class="reef" aria-hidden="true">
            <span class="kelp k1 art" style="--w:9;--h:30"></span>
            <span class="kelp k3 art" style="--w:9;--h:30"></span>
            <img class="px art rocks" style="--w:26;--h:11" src={withBase("/art/rocks.svg")} alt="" />
            <img class="px art starfish" style="--w:11;--h:9" src={withBase("/art/starfish.svg")} alt="" />
            <span class="crab art" style="--w:16;--h:9"></span>
            <span class="fish s4 art" style="--w:12;--h:6"></span>
            <div class="diver">
              <i class="hose"></i>
              <span class="act a-diver"></span>
            </div>
            <img class="bubble px art b4" style="--w:3;--h:3" src={withBase("/art/bubble.svg")} alt="" />
            <img class="bubble px art b5" style="--w:3;--h:3" src={withBase("/art/bubble.svg")} alt="" />
          </div>
        </div>
        <div class="sand tile" style="--tw:32;--th:14" aria-hidden="true"></div>
        <footer class="foot">
          <p>
            ship is licensed under the{" "}
            <a href="https://github.com/shipmux/ship/blob/main/LICENSE">gnu general public license v3.0 or later</a>. it
            is a work in progress.
          </p>
          <nav aria-label="footer">
            <a href={withBase("/docs/")}>docs</a>
            <a href={withBase("/#install")}>install</a>
            <a href={withBase("/#keys")}>keys</a>
            <a href={withBase("/#config")}>config</a>
            <a href="https://github.com/shipmux/ship">github</a>
          </nav>
        </footer>
      </section>
    </main>
    <script is:inline src={withBase("/js/site.js")} defer></script>
  </body>
</html>
