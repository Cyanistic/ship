{
 "name": "ship-16",
 "type": "dark",
 "colors": {
  "editor.background": "#1c1a27",
  "editor.foreground": "#d4ccb8"
 },
 "tokenColors": [
  {
   "settings": {
    "foreground": "#d4ccb8"
   }
  },
  {
